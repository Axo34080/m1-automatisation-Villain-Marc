    {
      "parameters": {
        "jsCode": "const MOTS_CLES = ['panne', 'bloquant', 'urgent'];\n\nreturn $input.all().flatMap(item => {\n  const { type, record, old_record } = item.json.body ?? {};\n  if (!record) return [];\n\n  if (type === 'UPDATE') {\n    if (old_record?.statut === record.statut) return []; \n    return [{\n      json: {\n        evenement: 'UPDATE',\n        ticket_id: record.id,\n        titre: record.titre.trim(),\n        ancien_statut: old_record?.statut,\n        nouveau_statut: record.statut,\n      },\n    }];\n  }\n\n  if (type !== 'INSERT') return [];\n\n  const titre = record.titre.trim();\n  const titreMin = titre.toLowerCase();\n\n  return [{\n    json: {\n      evenement: 'INSERT',\n      ticket_id: record.id,\n      organisation_id: record.organisation_id,\n      titre,\n      description: record.description,\n      priorite: record.priorite,\n      alerte_immediate:\n        record.priorite === 'critique' ||\n        MOTS_CLES.some(mot => titreMin.includes(mot)),\n    },\n  }];\n});"
      },
